menu "Embed Framework — WiFi Configuration"

    config EMBED_WIFI_SSID
        string "WiFi SSID"
        default "MyNetwork"
        help
            SSID of the WiFi network to connect to.

    config EMBED_WIFI_PASSWORD
        string "WiFi Password"
        default ""
        help
            Password for the WiFi network. Leave empty for open networks.

    config EMBED_WIFI_MAX_RETRY
        int "Maximum connection retry count"
        default 5
        range 0 100
        help
            Number of reconnection attempts before entering error state.

endmenu

menu "Embed Framework — MQTT Configuration"

    config EMBED_MQTT_BROKER_URI
        string "MQTT broker URI"
        default "mqtt://broker.example.com:1883"
        help
            MQTT broker URI. Use "mqtt://" for plain or "mqtts://" for TLS.

    config EMBED_MQTT_CLIENT_ID
        string "MQTT client ID"
        default "esp32s3-device"
        help
            MQTT client identifier sent to the broker.

    config EMBED_MQTT_USERNAME
        string "MQTT username"
        default ""
        help
            MQTT username for authentication. Leave empty if not needed.

    config EMBED_MQTT_PASSWORD
        string "MQTT password"
        default ""
        help
            MQTT password for authentication. Leave empty if not needed.

    config EMBED_MQTT_MAX_RETRY
        int "Maximum MQTT reconnection attempts"
        default 5
        range 0 100
        help
            Number of reconnection attempts before entering error state.

    config EMBED_MQTT_RECONNECT_INTERVAL_MS
        int "Reconnection retry interval (ms)"
        default 5000
        range 1000 300000
        help
            Interval between MQTT reconnection attempts.

    config EMBED_MQTT_KEEPALIVE
        int "MQTT keepalive interval (seconds)"
        default 120
        range 10 65535
        help
            MQTT keepalive interval sent to the broker.

endmenu

menu "Embed Framework — Metrics Configuration"

    config EMBED_METRICS_INTERVAL_MS
        int "Metrics collection interval (ms)"
        default 10000
        range 1000 3600000
        help
            Interval in milliseconds between automatic metrics collections.

    config EMBED_METRICS_ENABLE_STORAGE
        bool "Collect storage partition metrics"
        default y
        help
            Enable collection of flash storage partition metrics.

    config EMBED_METRICS_ENABLE_CPU
        bool "Collect CPU load metrics"
        default y
        depends on FREERTOS_GENERATE_RUN_TIME_STATS
        help
            Enable CPU load measurement via FreeRTOS idle task counters.
            Requires CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y in sdkconfig.

endmenu
