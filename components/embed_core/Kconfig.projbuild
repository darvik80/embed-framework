menu "Embed Framework — WiFi Configuration"

    config EMBED_WIFI_SSID
        string "WiFi SSID"
        default "MyNetwork"
        help
            SSID of the WiFi network to connect to.

    config EMBED_WIFI_PASSWORD
        string "WiFi Password"
        default ""
        help
            Password for the WiFi network. Leave empty for open networks.

    config EMBED_WIFI_MAX_RETRY
        int "Maximum connection retry count"
        default 5
        range 0 100
        help
            Number of reconnection attempts before entering error state.

endmenu

menu "Embed Framework — Config Portal"

    config EMBED_CONFIG_HTTP_STA
        bool "Serve config HTTP on STA (LAN IP)"
        default y
        help
            After WiFi connects, also serve the setup page on the device IP.
            Disable to only expose the UI on the SoftAP config portal.

    config EMBED_CONFIG_HTTP_PORT
        int "Config HTTP port"
        default 80
        range 1 65535

    config EMBED_CONFIG_AP_SSID_PREFIX
        string "SoftAP SSID prefix"
        default "embed"
        help
            AP name is "{prefix}-{MAC4}{MAC5}", e.g. embed-A1B2.

    config EMBED_CONFIG_AP_PASSWORD
        string "SoftAP password (empty = open)"
        default ""
        help
            WPA2 password for the config AP. Leave empty for an open network.

    config EMBED_CONFIG_RESET_GPIO
        int "Factory-reset hold GPIO (-1 = disable)"
        default 0
        range -1 48
        help
            Active-low button (BOOT is usually GPIO 0). Hold while the app is
            running — not during chip reset (GPIO 0 strap → download mode).

    config EMBED_CONFIG_RESET_HOLD_MS
        int "Factory-reset hold time (ms)"
        default 3000
        range 500 30000

    config EMBED_CONFIG_RST_BURST_COUNT
        int "EN/RST presses for factory reset (0 = disable)"
        default 3
        range 0 10
        help
            The board RST button is EN (chip reset), not a GPIO. ESP32-S3
            often reports that press as POWERON (not EXT) and wipes RTC RAM;
            the press counter is stored in NVS. Press RST N times quickly
            (before the clear timer). Default 3.

    config EMBED_CONFIG_RST_BURST_CLEAR_MS
        int "Clear EN/RST press counter after (ms)"
        default 10000
        range 1000 60000
        help
            After the device has been running this long, the EN/RST press
            counter is zeroed so a later single reset is just a reboot.

endmenu

menu "Embed Framework — MQTT Configuration"

    config EMBED_MQTT_BROKER_URI
        string "MQTT broker URI"
        default "mqtt://broker.example.com:1883"
        help
            MQTT broker URI. Use "mqtt://" for plain or "mqtts://" for TLS.

    config EMBED_MQTT_CLIENT_ID
        string "MQTT client ID"
        default "esp32s3-device"
        help
            MQTT client identifier sent to the broker.

    config EMBED_MQTT_USERNAME
        string "MQTT username"
        default ""
        help
            MQTT username for authentication. Leave empty if not needed.

    config EMBED_MQTT_PASSWORD
        string "MQTT password"
        default ""
        help
            MQTT password for authentication. Leave empty if not needed.

    config EMBED_MQTT_MAX_RETRY
        int "Maximum MQTT reconnection attempts"
        default 5
        range 0 100
        help
            Number of reconnection attempts before entering error state.

    config EMBED_MQTT_RECONNECT_INTERVAL_MS
        int "Reconnection retry interval (ms)"
        default 5000
        range 1000 300000
        help
            Interval between MQTT reconnection attempts driven by MqttService
            state machine (esp-mqtt auto-reconnect is disabled).

    config EMBED_MQTT_KEEPALIVE
        int "MQTT keepalive interval (seconds)"
        default 120
        range 10 65535
        help
            MQTT keepalive interval sent to the broker.

endmenu

menu "Embed Framework — Metrics Configuration"

    config EMBED_METRICS_INTERVAL_MS
        int "Metrics collection interval (ms)"
        default 10000
        range 1000 3600000
        help
            Interval in milliseconds between automatic metrics collections.

    config EMBED_METRICS_ENABLE_STORAGE
        bool "Collect storage partition metrics"
        default y
        help
            Enable collection of flash storage metrics for the "storage"
            SPIFFS partition (uses esp_spiffs_info when mounted).

    config EMBED_METRICS_ENABLE_CPU
        bool "Collect CPU load metrics"
        default y
        depends on FREERTOS_GENERATE_RUN_TIME_STATS
        help
            Enable CPU load measurement via FreeRTOS idle task counters.
            Requires CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y in sdkconfig.

endmenu
