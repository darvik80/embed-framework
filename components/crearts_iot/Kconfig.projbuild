menu "Embed Framework — Crearts IoT"

    config EMBED_CREARTS_IOT_PRODUCT_ID
        string "Product ID"
        default "home"
        help
            Stable product key used in MQTT username/client id and full topics
            (username = "{product}.{device}").

    config EMBED_CREARTS_IOT_DEVICE_ID
        string "Device ID"
        default "esp32-s3"
        help
            Unique device id within the product. Combined with product id as
            MQTT username and client_id.

    config EMBED_CREARTS_IOT_HOST
        string "MQTT broker host"
        default "192.168.1.100"
        help
            Hostname or IPv4 of the Crearts/RabbitMQ broker (no scheme).
            On device hardware use the LAN IP of the NAS/PC, not localhost.

    config EMBED_CREARTS_IOT_ACCESS_TOKEN
        string "Device access token"
        default ""
        help
            Token issued when the device is registered in the Crearts dashboard.
            Used as MQTT password (username is product.device).
            Set via menuconfig / sdkconfig — do not hardcode in source.

    config EMBED_CREARTS_IOT_USE_TLS
        bool "Use MQTT over TLS (mqtts / port 8883)"
        default n

    config EMBED_CREARTS_IOT_PORT
        int "MQTT port (0 = default 1883/8883)"
        default 0
        range 0 65535

    config EMBED_CREARTS_IOT_TOPIC_SHORT
        bool "Use short topics (v1/t, v1/a, ...)"
        default n
        help
            Prefer short topics for constrained devices. Disable for full
            iot/v1/{product}/{device}/... topics.

endmenu
