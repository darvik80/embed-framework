CONFIG_EMBED_WIFI_SSID="alibaba-guest"
CONFIG_EMBED_WIFI_PASSWORD=""
CONFIG_EMBED_WIFI_MAX_RETRY=5

CONFIG_EMBED_METRICS_INTERVAL_MS=10000
CONFIG_EMBED_METRICS_ENABLE_STORAGE=y

CONFIG_EMBED_MQTT_MAX_RETRY=5
CONFIG_EMBED_MQTT_RECONNECT_INTERVAL_MS=5000
CONFIG_EMBED_MQTT_KEEPALIVE=120
CONFIG_EMBED_MQTT_BROKER_URI="mqtt://broker.example.com:1883"
CONFIG_EMBED_MQTT_CLIENT_ID="esp32s3-device"
CONFIG_EMBED_MQTT_USERNAME=""
CONFIG_EMBED_MQTT_PASSWORD=""

CONFIG_EMBED_ALICLOUD_PRODUCT_KEY=""
CONFIG_EMBED_ALICLOUD_DEVICE_NAME=""
CONFIG_EMBED_ALICLOUD_DEVICE_SECRET=""

CONFIG_EMBED_THINGSBOARD_HOST="thingsboard.cloud"
CONFIG_EMBED_THINGSBOARD_ACCESS_TOKEN=""
CONFIG_EMBED_THINGSBOARD_USE_TLS=n
CONFIG_EMBED_THINGSBOARD_PORT=0
CONFIG_EMBED_THINGSBOARD_TOPIC_SHORT=y

# Crearts IoT — set token locally in sdkconfig / menuconfig (do not commit secrets)
CONFIG_EMBED_CREARTS_IOT_PRODUCT_ID="home"
CONFIG_EMBED_CREARTS_IOT_DEVICE_ID="esp32-s3"
CONFIG_EMBED_CREARTS_IOT_HOST="192.168.1.100"
CONFIG_EMBED_CREARTS_IOT_ACCESS_TOKEN=""
CONFIG_EMBED_CREARTS_IOT_USE_TLS=n
CONFIG_EMBED_CREARTS_IOT_PORT=0
# CONFIG_EMBED_CREARTS_IOT_TOPIC_SHORT is not set

CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Config portal — BOOT (GPIO 0) hold while running, not at chip reset
CONFIG_EMBED_CONFIG_RESET_GPIO=0
CONFIG_EMBED_CONFIG_RESET_HOLD_MS=3000
CONFIG_EMBED_CONFIG_RST_BURST_COUNT=3
CONFIG_EMBED_CONFIG_RST_BURST_CLEAR_MS=10000
CONFIG_EMBED_CONFIG_HTTP_STA=y
CONFIG_EMBED_CONFIG_HTTP_PORT=80

# WS2812 LED strips — GPIO bound at runtime (led_attach / attach())
CONFIG_EMBED_LED_STRIP=y
CONFIG_EMBED_LED_STRIP_MAX=4
CONFIG_EMBED_LED_STRIP_DEFAULT_BRIGHTNESS=32

# PSRAM — match the module marking (not menuconfig guess):
#   WROOM-1-N8R8 / N16R8 / Freenove CAM → Octal (OPI)  ← default below
#   …-N8R2 → Quad (QSPI); set CONFIG_SPIRAM_MODE_QUAD=y and unset OCTAL
#   …-N8 / no "R" → no PSRAM; comment out this block
# IGNORE_NOTFOUND: wrong mode must not abort in cpu_start (before app_main / OTA rollback).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCTAL=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# Use software SHA to avoid linker ordering issue with sha_hal symbols
CONFIG_MBEDTLS_HARDWARE_SHA=n
